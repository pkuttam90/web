# --------------------------------
# Continuous Insert Loop
# --------------------------------
doc_id = "my_jpeg"

response = cloudant.get_document(
    db="image",
    doc_id="my_jpeg"
).get_result()

current_rev = response["_rev"]

while(True):
    screen = ImageGrab.grab(bbox=(1000,1000,1400,1400)) # Set bbox=(x1, y1, x2, y2) for a specific region
    # Convert the PIL image to a NumPy array that OpenCV can use
    screen_numpy = np.array(screen)
    # Convert the color space from RGB (PIL default) to BGR (OpenCV default)
    # This is important for correct color display
    screen_opencv = cv2.cvtColor(screen_numpy, cv2.COLOR_RGB2BGR)
    #resized_image = cv2.resize(screen_opencv, (1280, 720))
    retval, buffer = cv2.imencode('.jpg', screen_opencv)
    jpg_as_text = base64.b64encode(buffer)
    # Display the captured screen frame in a window
    #cv2.imshow('Screen Capture', screen_opencv)
    document = {
        "_id": doc_id,
        "_rev": current_rev,
        "data": jpg_as_text.decode('utf-8'),
        "cnt": round(25 + (time.time() % 5), 2),
        "name": "temperature"
    }
    print(document)
    try:
        response = cloudant.post_document(
            db=DB_NAME,
            document=document
        ).get_result()
        print("Inserted:", response["id"])
        current_rev = response["rev"]
    except Exception as e:
        print("Insert failed:", e)
